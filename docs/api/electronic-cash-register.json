{
    "title": "Electronic Cash Register (ECR) V2 API",
    "description": "The ECR V2 API enables merchants to manage electronic cash registers for daily operations. This includes subscribing cash registers, opening/closing registers and shifts, managing cash deposits and withdrawals, and tracking register state. The API follows a sequential flow matching natural business day operations.",
    "endpoints": [
        {
            "fragment": "Create Cash Register",
            "method": "POST",
            "link": "API_URL/merchants/:merchantId/stores/:storeId/cash-register"
        },
        {
            "fragment": "Withdraw Cash",
            "method": "PUT",
            "link": "API_URL/merchants/:merchantId/stores/:storeId/cash-register/withdraw"
        },
        {
            "fragment": "Fetch Cash Registers",
            "method": "GET",
            "link": "API_URL/merchants/:merchantId/cash-register"
        },
        {
            "fragment": "Delete Cash Register",
            "method": "DELETE",
            "link": "API_URL/merchants/:merchantId/stores/:storeId/cash-register/:cashRegisterId"
        },
        {
            "fragment": "Get Cash Register State",
            "method": "GET",
            "link": "API_URL/merchants/:merchantId/stores/:storeId/cash-register/:cashRegisterId/state-info"
        },
        {
            "fragment": "Open-Shift",
            "method": "PUT",
            "link": "API_URL/merchants/:merchantId/stores/:storeId/cash-register/:cashRegisterId/open-shift"
        },
        {
            "fragment": "Close-Shift",
            "method": "PUT",
            "link": "API_URL/merchants/:merchantId/stores/:storeId/cash-register/:cashRegisterId/close-shift"
        },
        {
            "fragment": "End of Day",
            "method": "PUT",
            "link": "API_URL/merchants/:merchantId/stores/:storeId/cash-register/:cashRegisterId/end-of-day"
        },
        {
            "fragment": "Get Cash Register by ID",
            "method": "GET",
            "link": "API_URL/merchants/:merchantId/stores/:storeId/cash-register/:cashRegisterId"
        },
        {
            "fragment": "Update Scheduled Close Time",
            "method": "PATCH",
            "link": "API_URL/merchants/:merchantId/stores/:storeId/cash-register/:cashRegisterId/closing-time"
        },
        {
            "fragment": "Deposit Petty Cash",
            "method": "POST",
            "link": "API_URL/merchants/:merchantId/stores/:storeId/cash-register/deposit-petty-cash"
        },
        {
            "fragment": "Get Cash Register Files",
            "method": "GET",
            "link": "API_URL/merchants/:merchantId/stores/:storeId/cash-register/:cashRegisterId/files"
        }
    ],
    "apis": [
        {
            "heading": "Create Cash Register",
            "description": "Create a Cash Register for a specific store.",
            "reqParams": [
                {
                    "name": "cashRegisterName",
                    "type": "string",
                    "mandatory": true,
                    "description": "Name of the cash register."
                },
                {
                    "name": "deviceId",
                    "type": "string",
                    "mandatory": true,
                    "description": "Terminal / device identifier."
                },
                {
                    "name": "emails",
                    "type": "array",
                    "mandatory": false,
                    "description": "List of email addresses for notifications."
                }
            ],
            "resParams": [
                {
                    "name": "status",
                    "type": "string",
                    "mandatory": true,
                    "description": "Status of the request."
                },
                {
                    "name": "data",
                    "type": "object",
                    "mandatory": true,
                    "description": "Response data.",
                    "resParams": [
                        {
                            "name": "cashRegister",
                            "type": "object",
                            "mandatory": true,
                            "description": "Cash register details.",
                            "resParams": [
                                {
                                    "name": "cashRegisterId",
                                    "type": "string",
                                    "mandatory": true,
                                    "description": "Unique identifier for the cash register. Save this ID as it is required for opening the register and shifts."
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "message",
                    "type": "string",
                    "mandatory": true,
                    "description": "Response message."
                }
            ],
            "method": "POST",
            "path": "/merchants/:merchantId/stores/:storeId/cash-register",
            "examples": {
                "request": {
                    "headers": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        },
                        {
                            "name": "API-KEY",
                            "value": "YOUR_API_KEY"
                        },
                        {
                            "name": "API-SECRET",
                            "value": "YOUR_API_SECRET"
                        },
                        {
                            "name": "MERCHANT-ID",
                            "value": "YOUR_MERCHANT_ID"
                        }
                    ],
                    "body": "{\"cashRegisterName\":\"Main Register\",\"deviceId\":\"{{terminalId}}\",\"emails\":[\"store.manager@example.com\"]}"
                },
                "response": [
                    {
                        "code": 201,
                        "response": "\n{\n\t\"status\":\"SUCCESS\",\n\t\"data\":{\n\t\t\"cashRegister\":{\n\t\t\t\"cashRegisterId\":\"{{cashRegisterId}}\"\n\t\t}\n\t},\n\t\"message\":\"Cash register subscribed successfully\"\n}"
                    }
                ]
            }
        },
